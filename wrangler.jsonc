{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "headless-shofukuhara",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
	},
	"observability": {
		"enabled": true,
	},
}