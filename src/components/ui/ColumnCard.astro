---
import type { ColumnCategory } from "../../library/column";
import { formatDate } from "../../library/date";
import { optimizeImage } from "../../library/microcms";

interface Props {
  item: {
    meta: {
      slug: string;
      title: string;
      thumbnail?: { url?: string };
    };
    publishedAt?: string;
    category?: ColumnCategory | ColumnCategory[];
  };
}

const { item } = Astro.props as Props;

const categories = Array.isArray(item.category)
  ? item.category
  : item.category
    ? [item.category]
    : [];
---

<div class="c-column-card">
  <a href={`/column/${item.meta.slug}`} class="card-link">
    <div class="thumb">
      <img
        src={optimizeImage(item.meta.thumbnail?.url)}
        alt={item.meta.title}
        loading="lazy"
      />
    </div>
    <p class="title">{item.meta.title}</p>
    {item.publishedAt && <p class="date">{formatDate(item.publishedAt)}</p>}
  </a>
  {
    categories.length > 0 && (
      <div class="categories">
        {categories.map((category) => (
          <a href={`/column/category/${category.slug}`} class="category">
            {category.name}
          </a>
        ))}
      </div>
    )
  }
</div>

<style>
  .c-column-card {
    display: block;
    color: inherit;
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .c-column-card .thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-bg-subtle);
  }

  .c-column-card .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-column-card .title {
    margin: 16px 0 7px;
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--color-text);
  }

  .card-link:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .c-column-card .date {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .category {
    padding: 4px 8px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    text-decoration: none;
  }

  .category:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }

  .c-column-card .more {
    width: fit-content;
    margin: 56px auto 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .c-column-card .more:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
</style>
