---
import ColumnDetail from "../components/column/ColumnDetail.astro";
import Layout from "../layouts/Layout.astro";
import { getColumnPreview } from "../library/column";

export const prerender = false;

const contentId = Astro.url.searchParams.get("contentId");
const draftKey = Astro.url.searchParams.get("draftKey");

if (!contentId || !draftKey) {
  throw new Error("contentId または draftKey がありません");
}

const column = await getColumnPreview(contentId, draftKey);
---

<Layout title={column.meta.title}>
  <ColumnDetail column={column} />
</Layout>
