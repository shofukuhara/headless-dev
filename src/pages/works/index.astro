---
import Layout from "../../layouts/Layout.astro";
import { optimizeImage } from "../../library/microcms";
import { getWorks } from "../../library/works";

const { contents } = await getWorks();
---

<Layout title="Works">
  <section class="works-list">
    <div class="content">
      <div class="works-head">
        <h2>Works</h2>
      </div>
      <ul class="grid">
        {
          contents.map((item) => (
            <li class="card">
              <div class="thumb">
                <img
                  src={optimizeImage(item.image?.url)}
                  alt=""
                  loading="eager"
                />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  h2 {
    font-size: var(--font-size-xl);
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-bg-subtle);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .card a:hover .thumb img {
    transform: scale(1.04);
  }

  .title {
    margin: 12px 0 6px;
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--color-text);
  }

  .card a:hover .title {
    text-decoration: underline;
  }

  .date {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .works-list .inner {
      padding: 56px var(--container-padding);
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
