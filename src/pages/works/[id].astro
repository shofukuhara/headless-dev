---
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return [
    {
      params: { id: "sample-site" },
      props: {
        work: {
          title: "Sample Site",
          category: "Web design / Development",
          description:
            "サービスの魅力が伝わる情報設計と、更新しやすい仕組みを組み合わせたWebサイトです。",
          image: "/dummy.png",
          period: "2024.04 - 2024.06",
          role: "Planning, Design, Development",
        },
      },
    },
  ];
}

const { work } = Astro.props;
---

<Layout title={work.title} description={work.description}>
  <article class="work-detail">
    <div class="content">
      <header class="work-header">
        <h1>{work.title}</h1>
        <p class="description">{work.description}</p>
      </header>

      <div class="visual">
        <img src={work.image} alt={work.title} />
      </div>
    </div>
  </article>
</Layout>

<style>
  .work-detail .content {
    padding-top: 48px;
  }

  .back-link {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    text-underline-offset: 4px;
  }

  .work-header {
    max-width: 640px;
    margin: 80px 0 56px;
  }

  .category {
    margin-bottom: 20px;
    color: var(--color-accent);
    font-size: var(--font-size-sm);
  }

  h1 {
    margin: 0 0 24px;
    font-size: clamp(36px, 6vw, 64px);
    font-weight: 500;
    line-height: 1.2;
  }

  .description {
    max-width: 480px;
    margin: 0;
    color: var(--color-text-sub);
    line-height: 2;
  }

  .visual {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    background: var(--color-bg-subtle);
  }

  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 640px;
    margin: 56px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .details div {
    display: grid;
    gap: 8px;
  }

  dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  dd {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  @media (max-width: 560px) {
    .work-detail .content {
      padding-top: 32px;
    }

    .work-header {
      margin: 64px 0 40px;
    }

    .details {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
