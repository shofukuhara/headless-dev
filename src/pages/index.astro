---
// src/pages/index.astro
import Button from "../components/ui/Button.astro";
import ColumnCard from "../components/ui/ColumnCard.astro";
import WorksThumb from "../components/ui/WorksThumb.astro";
import Layout from "../layouts/Layout.astro";
import { getColumns } from "../library/column";
import { getWorks } from "../library/works";

const latestColumns = (await getColumns()).contents.slice(0, 3);
const latestWorks = (await getWorks()).contents.slice(0, 3);
---

<Layout title="Top">
  <section class="hero">
    <img src="fv.png" alt="" />
  </section>
  <div class="content">
    <section class="section">
      <div class="inner">
        <div class="section-head">
          <h2>Works</h2>
        </div>
        <ul class="grid">
          {
            latestWorks.map((item) => (
              <li class="card">
                <WorksThumb item={item} />
              </li>
            ))
          }
        </ul>
        <div class="more">
          <Button href="/works">Worksをもっと見る</Button>
        </div>
      </div>
    </section>
    <section class="section">
      <div class="inner">
        <div class="section-head">
          <h2>Column</h2>
        </div>
        <ul class="grid">
          {
            latestColumns.map((item) => (
              <li class="card">
                <ColumnCard item={item} />
              </li>
            ))
          }
        </ul>
        <div class="more">
          <Button href="/column">Columnをもっと見る</Button>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .inner {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* FV (Hero) */
  .hero img {
    width: 100%;
    aspect-ratio: 21 / 8;
    object-fit: cover;
    object-position: bottom;
    display: block;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .section-head h2 {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .more {
    width: fit-content;
    margin: 56px auto 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .more:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .hero img {
      aspect-ratio: 16 / 9;
    }

    .section {
      padding: 56px 0;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
