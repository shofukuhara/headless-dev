---
import ColumnCard from "../../components/ui/ColumnCard.astro";
import Layout from "../../layouts/Layout.astro";
import { getCategories } from "../../library/category";
import { getColumns } from "../../library/column";

const { contents } = await getColumns();
const { contents: categories } = await getCategories();
---

<Layout title="column">
  <section class="column-list">
    <div class="content">
      <div class="column-head">
        <h2>Column</h2>
        <nav class="category-nav" aria-label="カテゴリ">
          <a href="/column" class="active">All</a>
          {
            categories.map((category) => (
              <a href={`/column/category/${category.slug}`}>{category.name}</a>
            ))
          }
        </nav>
      </div>
      <ul class="grid">
        {
          contents.map((item) => (
            <li>
              <ColumnCard item={item} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <style>
    h2 {
      font-size: var(--font-size-xl);
      font-weight: 600;
      color: var(--color-text);
      margin: 0 0 48px;
    }

    .category-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: -24px 0 48px;
    }

    .category-nav a {
      padding: 7px 12px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      text-decoration: none;
    }

    .category-nav a:hover,
    .category-nav a.active {
      border-color: var(--color-text);
      color: var(--color-text);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 48px 28px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    @media (max-width: 900px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 560px) {
      .grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }
    }
  </style>
</Layout>
