---
import ColumnCard from "../../components/ui/ColumnCard.astro";
import Layout from "../../layouts/Layout.astro";
import { getColumns } from "../../library/column";

const { contents } = await getColumns();
---

<Layout title="column">
  <section class="column-list">
    <div class="content">
      <div class="column-head">
        <h2>Column</h2>
      </div>
      <ul class="grid">
        {
          contents.map((item) => (
            <li>
              <ColumnCard item={item} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <style>
    h2 {
      font-size: var(--font-size-xl);
      font-weight: 600;
      color: var(--color-text);
      margin: 0 0 48px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 48px 28px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    @media (max-width: 900px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 560px) {
      .column-list .inner {
        padding: 56px var(--container-padding);
      }

      .grid {
        grid-template-columns: 1fr;
        gap: 28px;
      }
    }
  </style>
</Layout>
