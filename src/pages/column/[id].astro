---
import Layout from "../../layouts/Layout.astro";
import { getColumn, getColumns } from "../../library/column";
import { optimizeImage } from "../../library/microcms";

export async function getStaticPaths() {
  const { contents } = await getColumns();
  return contents.map((content) => ({
    params: { id: content.id },
  }));
}

const { id } = Astro.params;

const column = await getColumn(id);

function formatDate(dateStr?: string) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(
    d.getDate(),
  ).padStart(2, "0")}`;
}
---

<Layout title={column.meta.title}>
  <article class="column-detail">
    <div class="inner">
      <header class="head">
        <h1>{column.meta.title}</h1>
        <!-- {
          column.publishedAt && (
            <time class="date" datetime={column.publishedAt}>
              {formatDate(column.publishedAt)}
            </time>
          )
        } -->
      </header>

      <div class="main-visual">
        <img
          src={optimizeImage(column.mainVisual.url, { width: 1200 })}
          alt={column.meta.title}
        />
      </div>

      <div class="prose" set:html={column.contents} />
    </div>
  </article>
</Layout>

<style>
  .column-detail .inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 80px var(--container-padding);
  }

  .head {
    margin-bottom: 24px;
  }

  .head h1 {
    font-size: 28px;
    line-height: 1.5;
    color: var(--color-text);
    margin: 0 0 8px;
  }

  .date {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .main-visual {
    margin: 0 0 40px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .main-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* CMSのリッチテキスト(content)の見た目調整 */
  .prose {
    font-size: var(--font-size-base);
    line-height: 1.9;
    color: var(--color-text-sub);
  }

  .prose :global(p) {
    margin: 0 0 1.5em;
  }

  .prose :global(h2) {
    font-size: 22px;
    margin: 2.4em 0 1em;
    padding-bottom: 0.4em;
    color: var(--color-text);
  }

  .prose :global(h3) {
    font-size: var(--font-size-lg);
    margin: 2em 0 0.8em;
    color: var(--color-text);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin: 1.5em 0;
  }

  .prose :global(a) {
    color: #1a5fb4;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5em;
    padding-left: 1.4em;
  }

  .prose :global(li) {
    margin-bottom: 0.4em;
  }

  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding: 0.2em 1.2em;
    border-left: 3px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .prose :global(code) {
    background: var(--color-bg-subtle);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .prose :global(pre) {
    background: #1e1e1e;
    color: #eee;
    padding: 1.2em;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    margin: 1.5em 0;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  @media (max-width: 560px) {
    .column-detail .inner {
      padding: 56px var(--container-padding);
    }

    .head h1 {
      font-size: 22px;
    }
  }
</style>
